  "license": "Apache-2.0",
  "main": "server.js",
  "type": "module",
  "dependencies": {
    "cd": "^0.3.3",
    "child_process": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.7.2",
    "http": "^0.0.1-security",
    "js-yaml": "^5.5.0",
    "json2html": "^0.0.8",
    "mathjs": "^15.2.0",
    "re": "^0.1.4",
    "ws": "^8.18.3",
    "xmlhttprequest": "^1.8.0"
  },
  "scripts": {
    "start": "node server.js",
    "build-client": "npm --prefix client run build",
    "install-client": "npm --prefix client install",
